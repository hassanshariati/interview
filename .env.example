# Copy to .env, set chmod 600, DO NOT commit secrets.
APP_ORIGIN=https://interview.armember.ir
COOKIE_SECURE=true
# Local host-only port for the Docker nginx reverse proxy.
APP_BIND_PORT=18080
BOOTSTRAP_ADMIN_EMAIL=
# Set a unique >=14-character password for first boot. Remove from .env after the first successful boot.
BOOTSTRAP_ADMIN_PASSWORD=
# Use URL-safe alphanumeric/base64url chars, as this value is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
# OPTIONAL EMAIL: requires SMTP with STARTTLS (port 587 recommended).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INVITATION_TTL_DAYS=30
# Choose one LLM provider. DeepSeek uses its TEXT Chat API, not OpenAI Realtime.
# Browser speech recognition/synthesis are optional; support depends on the browser.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_QUESTIONS_PER_INTERVIEW=10
AI_QUESTIONS_PER_HOUR=80
# OpenAI Realtime only for LLM_PROVIDER=openai (if separately configured).
# Voice service disabled until key, privacy review and testing are complete.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
ENABLE_REALTIME=false

# Hourly database-backed ceiling for self-service interview links.
PUBLIC_APPLICATIONS_PER_HOUR=20

# Optional management alert: configure n8n HTTPS webhook with Header Auth, OR manager SMTP.
# Never insert a real secret in tracked files. Webhook has precedence over manager SMTP.
N8N_REPORT_WEBHOOK_URL=
N8N_REPORT_WEBHOOK_SECRET=
MANAGER_REPORT_EMAIL=
