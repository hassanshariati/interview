# Copy to .env, set chmod 600, DO NOT commit secrets.
APP_ORIGIN=https://interview.armember.ir
COOKIE_SECURE=true
# Local host-only port for the Docker nginx reverse proxy.
APP_BIND_PORT=18080
BOOTSTRAP_ADMIN_EMAIL=
# Set a unique >=14-character password for first boot. Remove from .env after the first successful boot.
BOOTSTRAP_ADMIN_PASSWORD=
# Use URL-safe alphanumeric/base64url chars, as this value is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
# Email delivery through an existing n8n instance. Import deploy/n8n/interview-email.json.
EMAIL_PROVIDER=n8n
N8N_EMAIL_WEBHOOK_URL=
# Match the n8n Header Auth credential named X-Interview-Token.
N8N_EMAIL_WEBHOOK_TOKEN=
# SMTP_FROM is the sender passed to n8n. SMTP credentials stay inside n8n.
# Set EMAIL_PROVIDER=smtp only if direct STARTTLS delivery is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INVITATION_TTL_DAYS=30
# Voice service disabled until key, privacy review and testing are complete.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
ENABLE_REALTIME=false
